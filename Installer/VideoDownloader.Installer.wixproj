<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <!-- Without this, "dotnet build -c Release" (no explicit -p:Platform) defaults to x86,
         producing a 32-bit MSI that installs to "Program Files (x86)" and registers in ARP as
         X86 even though the packaged app is x64 - mismatched with Product.wxs's Platform="x64"
         and with the winget manifest's declared Architecture: x64. -->
    <Platform>x64</Platform>
    <ProductVersion>0.7.2</ProductVersion>
    <OutputName>VideoDownloader-$(ProductVersion)-Setup</OutputName>
    <!-- Publish output of VideoDownloader.Wpf that gets packaged into the MSI. Build that
         project in Release first - this project only packages the existing output, it doesn't
         build the app itself. -->
    <!-- Full path, not "..\...": MSBuild's wildcard Exclude patterns in StageAppFiles silently
         failed to match against a ".."-relative Include, so .zip and linux/osx runtimes leaked
         into the MSI (54 MB instead of ~22 MB). -->
    <AppPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\VideoDownloader.Wpf\bin\Release\net8.0-windows\'))</AppPublishDir>
    <!-- Windows-only subset of AppPublishDir, filtered by StageAppFiles below (no .pdb, no
         non-Windows native runtimes, no leftover release zip) since WiX's own Files/Exclude
         glob doesn't support a mid-segment wildcard like "runtimes\linux-*\**". -->
    <StagedAppDir>obj\app\</StagedAppDir>
    <DefineConstants>ProductVersion=$(ProductVersion);AppPublishDir=$(StagedAppDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="StageAppFiles" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_AppFiles Include="$(AppPublishDir)**\*.*"
                 Exclude="$(AppPublishDir)**\*.pdb;
                          $(AppPublishDir)runtimes\linux-*\**\*.*;
                          $(AppPublishDir)runtimes\osx-*\**\*.*;
                          $(AppPublishDir)runtimes\maccatalyst-*\**\*.*;
                          $(AppPublishDir)runtimes\browser-*\**\*.*;
                          $(AppPublishDir)*.zip" />
      <_StagedTargets Include="@(_AppFiles->'$(StagedAppDir)%(RecursiveDir)%(Filename)%(Extension)')" />
      <!-- Files left over from an earlier stage (dropped from, or wrongly let into, the app output).
           Deleted file-by-file rather than RemoveDir: the repo lives under OneDrive, which can hold
           a directory handle and make RemoveDir fail with "access denied". -->
      <_StaleStaged Include="$(StagedAppDir)**\*.*" Exclude="@(_StagedTargets)" />
    </ItemGroup>
    <Delete Files="@(_StaleStaged)" />
    <Copy SourceFiles="@(_AppFiles)"
          DestinationFiles="@(_AppFiles->'$(StagedAppDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
